# Environment variables for MovieGraph Backend
# Copy this file to .env and fill in your actual values.

# DeepSeek API (not required for the Step 5 retrieval-only experiment)
# Create a key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Legacy optional email configuration; not used by MovieGraph retrieval.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
